package components

import (
	"fmt"
	"github.com/duvlsag-mail/webmail/internal/mail"
	"net/url"
	"time"
)

templ MessageRows(folder string, msgs []mail.MessageSummary, next uint32) {
	for _, m := range msgs {
		<a class="message-row" hx-get={ fmt.Sprintf("/mail/view?folder=%s&id=%d", url.QueryEscape(folder), m.UID) } hx-trigger="click" hx-target="#reader" hx-swap="innerHTML">
			<div class="message-row-item">
				<div class="message-row-item-header">
					<span class="message-row-item-author">
						for _, addr := range m.From {
							if addr.Name != "" {
								{ addr.Name }
							} else {
								{ addr.Email }
							}
						}
					</span>
					<time datetime={ m.Date.Format(time.RFC3339) }>{ m.Date.Format("Jan 2, 2006 3:04 PM") }</time>
				</div>
				<span class="message-row-item-subject">{ m.Subject }</span>
			</div>
		</a>
	}
	if next > 0 {
		<button
			hx-get={ fmt.Sprintf("/mail/list?folder=%s&before=%d", url.QueryEscape(folder), next) }
			hx-trigger="click"
			hx-swap="outerHTML"
			class="message-row-load-more"
		>Load more</button>
	}
}
