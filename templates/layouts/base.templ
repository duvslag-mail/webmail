package layouts

templ Base(title string, pageCSS []string) {
	<html>
		<head>
			<meta charset="UTF-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
			<title>{ title }</title>
			// htmx
			<script src="https://cdn.jsdelivr.net/npm/htmx.org@2.0.11/dist/htmx.min.js" integrity="sha384-2OatzQy1H+Zd/IIrjr1TcuDGqLXeHhbooAyJY1KdQMKnr4LZ22k31GBLdYKHmVjg" crossorigin="anonymous"></script>
			<link rel="stylesheet" href="/static/css/_reset.css"/>
			<link rel="stylesheet" href="/static/css/layers.css"/>
			<link rel="stylesheet" href="/static/css/colors.css"/>
			<link rel="stylesheet" href="/static/css/fonts.css"/>
			<link rel="stylesheet" href="/static/css/base.css"/>
			<link rel="stylesheet" href="/static/css/components.css"/>
			for _, file := range pageCSS {
				<link rel="stylesheet" href={ file }/>
			}
			<link rel="stylesheet" href="/static/css/utilities.css"/>
		</head>
		<body>
			<main>
				{ children... }
			</main>
		</body>
	</html>
}
